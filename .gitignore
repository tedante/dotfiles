.DS_Store
DS_Store
.zshrc_local

# Per-machine repo list for script/git-autopush.sh
script/repos-auto-push

# systemd writes enablement symlinks here; ~/.config/systemd is stowed into
# systemd/.config/systemd, so they would otherwise land in the repo.
systemd/.config/systemd/user/*.wants/

# Local issue tracker and specs (skills write here)
.scratch/

# opencode credential: never vendor or publish
opencode/**/service.json
opencode/**/.env
opencode/**/.env.*
opencode/**/id_rsa
opencode/**/id_ed25519
opencode/**/*.pem
opencode/**/*.key
